# Copy to .env and fill in. NEVER commit .env.

# FalkorDB (local Docker default shown; no auth needed for the local container)
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_GRAPH=echo
# Only set these if your server requires auth (leave blank for local Docker):
FALKORDB_USERNAME=
FALKORDB_PASSWORD=

# Graph used by `pytest -m db` (kept separate from FALKORDB_GRAPH)
ECHO_TEST_GRAPH=echo_test

# LLM provider key (only needed from the agent stage; not used yet)
ANTHROPIC_API_KEY=
